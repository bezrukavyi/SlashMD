{
  "name": "markeasy",
  "displayName": "Markeasy",
  "description": "A Notion-like block-based WYSIWYG editor for Markdown files",
  "publisher": "markeasy",
  "galleryBanner": {
    "color": "#161617",
    "theme": "dark"
  },
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Formatters",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "wysiwyg",
    "notion",
    "block-editor",
    "md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bezrukavyi/markeasy"
  },
  "bugs": {
    "url": "https://github.com/bezrukavyi/markeasy/issues"
  },
  "homepage": "https://github.com/bezrukavyi/markeasy",
  "license": "MIT",
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "markeasy.editor",
        "displayName": "Markeasy",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "markeasy.openAsText",
        "title": "Open as Raw Markdown",
        "category": "Markeasy",
        "icon": {
          "light": "media/code-light.svg",
          "dark": "media/code-dark.svg"
        }
      },
      {
        "command": "markeasy.openAsMarkeasy",
        "title": "Open as Markeasy",
        "category": "Markeasy",
        "icon": {
          "light": "media/blocks-light.svg",
          "dark": "media/blocks-dark.svg"
        }
      },
      {
        "command": "markeasy.copyContent",
        "title": "Copy Markdown Content",
        "category": "Markeasy",
        "icon": {
          "light": "media/copy-light.svg",
          "dark": "media/copy-dark.svg"
        }
      },
      {
        "command": "markeasy.insertBlock",
        "title": "Insert Block…",
        "category": "Markeasy"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markeasy.copyContent",
          "when": "activeCustomEditorId == markeasy.editor",
          "group": "navigation"
        },
        {
          "command": "markeasy.openAsText",
          "when": "activeCustomEditorId == markeasy.editor",
          "group": "navigation"
        },
        {
          "command": "markeasy.copyContent",
          "when": "resourceLangId == markdown && activeCustomEditorId != markeasy.editor",
          "group": "navigation"
        },
        {
          "command": "markeasy.openAsMarkeasy",
          "when": "resourceLangId == markdown && activeCustomEditorId != markeasy.editor",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Markeasy",
      "properties": {
        "markeasy.assets.folder": {
          "type": "string",
          "default": "assets",
          "description": "Relative folder for pasted/dragged images."
        },
        "markeasy.assets.imagePathResolution": {
          "type": "string",
          "enum": [
            "document",
            "workspace"
          ],
          "default": "document",
          "description": "How to resolve relative image paths in markdown.",
          "enumDescriptions": [
            "Resolve paths relative to the markdown file's directory (recommended, matches standard markdown behavior)",
            "Resolve paths relative to the workspace root"
          ]
        },
        "markeasy.format.wrap": {
          "type": "integer",
          "default": 0,
          "description": "Markdown wrap width (0 = no wrap)."
        },
        "markeasy.callouts.style": {
          "type": "string",
          "enum": [
            "admonition",
            "emoji"
          ],
          "default": "admonition",
          "description": "Style for callout blocks."
        },
        "markeasy.toggles.syntax": {
          "type": "string",
          "enum": [
            "details",
            "list"
          ],
          "default": "details",
          "description": "Syntax for toggle blocks."
        },
        "markeasy.math.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable math block support."
        },
        "markeasy.mermaid.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Mermaid diagram support."
        },
        "markeasy.theme.codeTheme": {
          "type": "string",
          "enum": [
            "auto",
            "dark",
            "light",
            "github-dark",
            "github-light",
            "monokai"
          ],
          "default": "auto",
          "description": "Syntax highlighting theme for code blocks. 'auto' follows your VS Code theme.",
          "enumDescriptions": [
            "Automatically match your VS Code theme (dark or light)",
            "Dark theme (VS Code Dark+)",
            "Light theme (VS Code Light+)",
            "GitHub Dark theme",
            "GitHub Light theme",
            "Monokai theme"
          ]
        },
        "markeasy.theme.headingColor": {
          "type": "string",
          "default": "",
          "description": "Custom color for all headings. Can be overridden per level with h1Color through h5Color."
        },
        "markeasy.theme.h1Color": {
          "type": "string",
          "default": "",
          "description": "Custom color for H1 headings. Overrides headingColor for H1."
        },
        "markeasy.theme.h2Color": {
          "type": "string",
          "default": "",
          "description": "Custom color for H2 headings. Overrides headingColor for H2."
        },
        "markeasy.theme.h3Color": {
          "type": "string",
          "default": "",
          "description": "Custom color for H3 headings. Overrides headingColor for H3."
        },
        "markeasy.theme.h4Color": {
          "type": "string",
          "default": "",
          "description": "Custom color for H4 headings. Overrides headingColor for H4."
        },
        "markeasy.theme.h5Color": {
          "type": "string",
          "default": "",
          "description": "Custom color for H5 headings. Overrides headingColor for H5."
        },
        "markeasy.theme.h1Indent": {
          "type": "string",
          "default": "",
          "description": "Left indent for H1 headings (e.g., '16px' or '1em')."
        },
        "markeasy.theme.h2Indent": {
          "type": "string",
          "default": "",
          "description": "Left indent for H2 headings (e.g., '16px' or '1em')."
        },
        "markeasy.theme.h3Indent": {
          "type": "string",
          "default": "",
          "description": "Left indent for H3 headings (e.g., '32px' or '2em')."
        },
        "markeasy.theme.h4Indent": {
          "type": "string",
          "default": "",
          "description": "Left indent for H4 headings (e.g., '48px' or '3em')."
        },
        "markeasy.theme.h5Indent": {
          "type": "string",
          "default": "",
          "description": "Left indent for H5 headings (e.g., '64px' or '4em')."
        },
        "markeasy.theme.boldColor": {
          "type": "string",
          "default": "",
          "description": "Custom color for bold text (e.g., '#d19a66' or 'orange'). Leave empty to use default."
        },
        "markeasy.theme.italicColor": {
          "type": "string",
          "default": "",
          "description": "Custom color for italic text (e.g., '#98c379' or 'green'). Leave empty to use default."
        },
        "markeasy.theme.fontScale": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 3,
          "description": "Font size scale multiplier relative to VS Code's editor font size (e.g., 1.2 = 20% larger, 0.9 = 10% smaller)."
        },
        "markeasy.layout.pageWidth": {
          "type": "number",
          "default": 800,
          "minimum": 640,
          "maximum": 1600,
          "description": "Maximum width of the Markeasy editor page in pixels."
        },
        "markeasy.layout.sidePadding": {
          "type": "number",
          "default": 32,
          "minimum": 0,
          "maximum": 96,
          "description": "Left and right padding around the Markeasy editor page in pixels."
        }
      }
    }
  },
  "scripts": {
    "build": "tsup src/extension.ts --format cjs --dts --outDir dist --external vscode",
    "dev": "tsup src/extension.ts --format cjs --watch --outDir dist --external vscode",
    "lint": "eslint src",
    "package": "rm -rf .vsce-pkg && mkdir -p .vsce-pkg && cp -r package.json README.md dist media .vsce-pkg/ && cp ../../LICENSE .vsce-pkg/ && rm -f .vsce-pkg/dist/*.map && cd .vsce-pkg && vsce package --no-dependencies -o ../markeasy.vsix && cd .. && rm -rf .vsce-pkg",
    "publish": "npm run package && vsce publish --packagePath markeasy.vsix",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "zod": "^4.1.13"
  }
}
