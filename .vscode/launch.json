{
  "$schema": "vscode://schemas/launch",
  "version": "1.0.0",
  "configurations": [
    {
      "name": "Run Markeasy Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/extension-host",
        "--user-data-dir=${workspaceFolder}/.vscode/dev-user-data"
      ],
      "outFiles": ["${workspaceFolder}/packages/extension-host/dist/**/*.js"]
    },
    {
      "name": "Run Markeasy Extension (with build)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/extension-host",
        "--user-data-dir=${workspaceFolder}/.vscode/dev-user-data"
      ],
      "outFiles": ["${workspaceFolder}/packages/extension-host/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    }
  ]
}
